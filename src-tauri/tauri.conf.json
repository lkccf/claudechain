{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeChain",
  "version": "1.0.0",
  "identifier": "local.claudechain.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClaudeChain",
        "width": 430,
        "height": 760,
        "minWidth": 390,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code 住宅IP链式代理",
    "longDescription": "本机 → 前置代理(FlClash 等) → 住宅IP 的链式代理，一键启动走住宅IP的 Claude Code。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
